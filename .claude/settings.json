{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "leb hook bash",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "leb hook pretool",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Read|Edit|Write|MultiEdit"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "leb hook session-end",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "leb hook session-start",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "leb hook prompt",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}