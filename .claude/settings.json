{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "engram hook bash",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "engram hook pretool",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Read|Edit|Write|MultiEdit"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "engram hook session-end",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "engram hook session-start",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "engram hook prompt",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gcloud run jobs execute agents-cloudsql-verify:*)",
      "Bash(gcloud logging read:*)"
    ]
  }
}
